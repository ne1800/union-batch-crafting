# LLVM matches the existing two-space indentation. Keep reference/pointer spelling
# and source order. Adjacent string tokens and include order are build contracts.
BasedOnStyle: LLVM
IndentWidth: 2
ColumnLimit: 100
PointerAlignment: Left
SortIncludes: Never
BreakStringLiterals: false
ReflowComments: Never
FixNamespaceComments: false
