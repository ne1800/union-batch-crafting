LANGUAGE 7, 1
1 VERSIONINFO
 FILEVERSION @UBC_VERSION_COMMAS@
 PRODUCTVERSION @UBC_VERSION_COMMAS@
 FILEOS 0x40004
 FILETYPE 2
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040704b0"
    BEGIN
      VALUE "FileVersion", "@UBC_VERSION@\0"
      VALUE "ProductName", "Union Batch Crafting\0"
      VALUE "ProductVersion", "@UBC_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0407, 1200
  END
END
